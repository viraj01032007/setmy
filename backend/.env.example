# Copy to .env for local development. On Render, add these under Environment.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DATABASE_URL=postgres://...            # Render Postgres connection string (omit locally to use SQLite)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# Optional: lets you sign in to the Django /admin/ site as "admin"
DJANGO_SUPERUSER_PASSWORD=
